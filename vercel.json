{
  "version": 2,
  "installCommand": "unset NPM_TOKEN; unset NPM_CONFIG_AUTH; unset NPM_CONFIG__AUTH; rm -f ~/.npmrc; npm cache clean --force; npm install --registry=https://registry.npmjs.org/",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/dev-metrics/browser",
  "rewrites": [
    { "source": "/api/cursor/:path*", "destination": "/api/cursor" },
    { "source": "/api/jira/:path*", "destination": "/api/jira" },
    { "source": "/api/bitbucket/:path*", "destination": "/api/bitbucket" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
